<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy_blue"
    android:fillViewport="true"
    android:windowSoftInputMode="adjustPan">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Logo -->
        <ImageView
            android:id="@+id/logo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="32dp"
            android:contentDescription="Logo"
            android:src="@drawable/recruitguard_logo__bigger"
        />

        <!-- Email Input -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Registered Email Address"
            android:textColor="#ffffff"
            android:textSize="16sp"
        />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/emailInput"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/input_background"
                android:inputType="textEmailAddress"
                android:padding="16dp"
                android:textColor="#000000"
            />

            <Button
                android:id="@+id/verifyEmailButton"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#589DCD"
                android:text="Verify"
                android:textColor="#ffffff"
            />
        </LinearLayout>

        <!-- Hidden Section (shown after email verification) -->
        <LinearLayout
            android:id="@+id/securitySection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Security Question (It is Auto-selected and greyed out for the user) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Security Question"
                android:textColor="#ffffff"
                android:textSize="16sp"
            />

            <Spinner
                android:id="@+id/securityQuestionSpinner"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_background_disabled"
                android:enabled="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
            />

            <!-- Security Answer -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Security Answer"
                android:textColor="#ffffff"
                android:textSize="16sp"
            />

            <EditText
                android:id="@+id/securityAnswerInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_background"
                android:inputType="text"
                android:padding="16dp"
                android:textColor="#000000"
            />

            <!-- New Password -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="New Password"
                android:textColor="#ffffff"
                android:textSize="16sp"
            />

            <EditText
                android:id="@+id/newPasswordInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_background"
                android:inputType="textPassword"
                android:padding="16dp"
                android:textColor="#000000"
                android:drawableEnd="@drawable/ic_eye_off"            />

            <!-- Confirm Password -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Confirm New Password"
                android:textColor="#ffffff"
                android:textSize="16sp"
            />

            <EditText
                android:id="@+id/confirmPasswordInput"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_background"
                android:inputType="textPassword"
                android:padding="16dp"
                android:textColor="#000000"
                android:drawableEnd="@drawable/ic_eye_off"
            />

            <!-- Reset Button -->
            <Button
                android:id="@+id/resetPasswordButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="48dp"
                android:backgroundTint="#589DCD"
                android:text="Reset Password"
                android:textColor="#ffffff"
                android:textSize="16sp"
            />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
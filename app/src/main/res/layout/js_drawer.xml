<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/js_drawer_panel"
    android:layout_width="300dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:orientation="vertical"
    android:background="@color/js_navy"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/js_drawer_close"
        android:layout_width="48dp"
        android:layout_height="56dp"
        android:layout_marginStart="4dp"
        android:padding="12dp"
        android:contentDescription="Close menu"
        android:src="@drawable/js_ic_menu" />

    <LinearLayout
        android:id="@+id/js_menu_home"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="?attr/selectableItemBackground">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:contentDescription="@null" android:src="@drawable/js_ic_home" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="20dp" android:text="Home"
            android:textColor="#FFFFFF" android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/js_menu_history"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="?attr/selectableItemBackground">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:contentDescription="@null" android:src="@drawable/js_ic_history" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="20dp" android:text="History"
            android:textColor="#FFFFFF" android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/js_menu_notifications"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="?attr/selectableItemBackground">
        <ImageView android:layout_width="24dp" android:layout_height="24dp"
            android:contentDescription="@null" android:src="@drawable/js_ic_bell" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="20dp" android:text="Notifications"
            android:textColor="#FFFFFF" android:textSize="16sp" />
        <View
            android:id="@+id/js_menu_badge"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="10dp"
            android:visibility="gone"
            android:background="@drawable/js_circle"
            android:backgroundTint="@color/js_red" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/js_menu_logout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="?attr/selectableItemBackground">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_lock_power_off"
            android:tint="#FFFFFF"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="Sign out"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
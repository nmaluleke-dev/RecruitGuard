<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EFEFEF">

    <!-- Top Navy Header Bar  -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarAuditTrail"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#03143b"
        app:titleTextColor="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@android:color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="150dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_header_logo"
                android:contentDescription="RecruitGuard Logo"
                android:scaleType="fitCenter" />
        </LinearLayout>
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <!-- Header Section: Subtitle, Search Bar & Filter Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Audit Trail"
            android:textColor="#03143b"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#CCCCCC" />

        <!-- Search Input Bar -->
        <EditText
            android:id="@+id/etSearchAudit"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="#E4E4E4"
            android:hint="Search by Scan ID, Admin, or Decision..."
            android:textColorHint="#666666"
            android:textColor="#03143b"
            android:paddingHorizontal="12dp"
            android:textSize="12sp"
            android:maxLines="1" />

        <!-- Filter Action Buttons  -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnFilterAllLogs"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#589DCD"
                android:text="All Logs"
                android:textSize="10sp"
                android:textColor="@android:color/white" />

            <Button
                android:id="@+id/btnFilterHighRisk"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#589DCD"
                android:text="Fraud/High Risk"
                android:textSize="10sp"
                android:textColor="@android:color/white" />

            <Button
                android:id="@+id/btnFilterLegitimate"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:backgroundTint="#589DCD"
                android:text="Legitimate"
                android:textSize="10sp"
                android:textColor="@android:color/white" />
        </LinearLayout>
    </LinearLayout>

    <!-- Stats Summary Section-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:elevation="2dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total Postings Audited: 4"
            android:textColor="#03143b"
            android:textSize="14sp"
            android:textStyle="bold"
            android:id="@+id/tvTotalAudited"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Total High Risk (Fraud): 2"
            android:textColor="#D32F2F"
            android:textSize="13sp"
            android:id="@+id/tvTotalHighRisk"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Total Low Risk (Legitimate): 2"
            android:textColor="#2E7D32"
            android:textSize="13sp"
            android:id="@+id/tvTotalLowRisk"/>
    </LinearLayout>

    <!-- RecyclerView for Dynamic Logs -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewAuditTrail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="12dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

</LinearLayout>